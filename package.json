{
  "name": "proches",
  "version": "0.1.0",
  "private": true,
  "description": "Proches — documents, tâches et agenda partagés pour accompagner un parent âgé",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "predev": "node scripts/pdfjs-assets.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/pdfjs-assets.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:inviter": "vite-node scripts/inviter.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "next": "^15.1.6",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite-node": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
